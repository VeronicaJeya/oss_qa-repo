pipeline {
  agent any
    tools {
        maven 'maven-3'   
        dockerTool 'docker'
    }
  
  stages {
    stage("SCM Checkout") {
      steps {
         // clone the repository
         git 'https://github.com/CSPF-Founder/JavaVulnerableLab.git'
         
      }
    }
    stage("Remove Dependencies") {
      steps {
       
        sh 'rm -rf /var/lib/jenkins/.m2'
         
      }
    }

    
         stage("Build and Initiate SCA & SBOM Scans") {
            steps {
               // Build the application and run Dependency-Check-Maven & CodeDX SBOM plugins
            sh 'mvn -B deploy'
               
            }
         }
     //  } // end of Parallel
   // } // end of Scan Stage
    
  } // end of stages
}

